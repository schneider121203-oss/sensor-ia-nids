<!-- ================================================================
     Reglas personalizadas para alertas del Ensemble de Anomalías
     Archivo: /var/ossec/etc/rules/custom_rules.xml

     El sensor aplica el único umbral guardado en meta.json.
     Wazuh solo prioriza las anomalías ya detectadas:
       7  → Sospechosa
       10 → Alta
       13 → Crítica
     ================================================================ -->
<group name="ensemble_anomaly,">

  <!-- Regla base: cualquier alerta del ensemble -->
  <rule id="110001" level="5">
    <decoded_as>json</decoded_as>
    <field name="source">^ensemble$</field>
    <description>Ensemble IDS: flujo anómalo detectado (score: $(score))</description>
    <group>anomaly_detection,</group>
  </rule>

  <!-- La detección ya fue decidida por el único umbral del modelo. -->
  <!-- Estas reglas solo priorizan la severidad dentro de las anomalías. -->
  <rule id="110002" level="7">
    <if_sid>110001</if_sid>
    <field name="severity">^suspicious$</field>
    <description>Ensemble IDS: Tráfico sospechoso desde $(src_ip) → $(dst_ip) [score=$(score)]</description>
    <group>anomaly_detection,suspicious,</group>
  </rule>

  <!-- Nivel 10: Probable ataque -->
  <rule id="110003" level="10">
    <if_sid>110001</if_sid>
    <field name="severity">^high$</field>
    <description>Ensemble IDS: ANOMALÍA ALTA desde $(src_ip) → $(dst_ip) [score=$(score), proto=$(protocol)]</description>
    <group>anomaly_detection,high_score,</group>
  </rule>

  <!-- Nivel 13: anomalía crítica dentro del rango sobre el umbral -->
  <rule id="110004" level="13">
    <if_sid>110001</if_sid>
    <field name="severity">^critical$</field>
    <description>Ensemble IDS: ANOMALÍA CRÍTICA desde $(src_ip) [score=$(score), proto=$(protocol), duración=$(duration_ms)ms]</description>
    <group>anomaly_detection,high_score,</group>
  </rule>

</group>
